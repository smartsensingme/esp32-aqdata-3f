# ==============================================================================
# Configuracao de desempenho e posicionamento em IRAM
# ==============================================================================

# Coloca as funcoes suportadas do FreeRTOS em IRAM (ESP-IDF v6.0).
CONFIG_FREERTOS_IN_IRAM=y

# Forca o driver do SPI Master e sua ISR a rodarem da IRAM
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# Coloca as funcoes do ring buffer usado pelo ADC em IRAM.
CONFIG_RINGBUF_IN_IRAM=y

# Otimiza o firmware para desempenho (-O2).
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Active-low offset calibration request at startup (internal pull-up).
CONFIG_APP_OFFSET_CAL_GPIO=7

# Shared symmetric command limit for all three phases.
CONFIG_APP_CONTROL_LIMIT_MV=6000

# Keep the shared-actuator coordinator in internal instruction RAM.
CONFIG_ESP_ANTI_WINDUP_IRAM=y
